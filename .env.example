# Player backend: "openrouter" | "jev" | "algorithm"
SNAKE_PLAYER=openrouter

# OpenRouter configuration (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to run via OpenRouter:
#   TypeSafe Jev models on OpenRouter (auto-routed to https://openrouter.ai/api/v1/systemone):
#     typesafe/jev-latest
#     typesafe/jev-1.14
#     typesafe/jev-1.13
#     typesafe/jev-router
#   Standard LLMs on OpenRouter (auto-routed to https://openrouter.ai/api/v1/chat/completions):
#     google/gemini-2.5-flash-lite
#     openai/gpt-4o-mini
#     meta-llama/llama-3.1-8b-instruct
#     anthropic/claude-3.5-haiku
OPENROUTER_MODEL=typesafe/jev-latest

# Optional endpoint override (leave blank to auto-select /api/v1/systemone for Jev or /api/v1/chat/completions for LLMs)
OPENROUTER_BASE_URL=

# For chat LLMs on OpenRouter: 1 = include short lookahead "plan" before "move" in JSON; 0 = move token only
OPENROUTER_COT=1

# Direct TypeSafe API configuration (optional; used only if calling api.typesafe.ai directly without OpenRouter)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Survival & latency optimizations:
#   full   = 1-step collision filter + multi-step dead-end verifier + 0ms forced-move short-circuit + late-frame fallback
#   safe   = 1-step collision filter + 0ms forced-move short-circuit + late-frame fallback
#   prompt = enrich prompt/criteria with lookahead metrics only (no move filtering)
#   off    = original baseline behavior
SNAKE_GUARD=full

# 1 = compact board grid + coordinate header (~45% fewer tokens); 0 = original space-padded grid
SNAKE_COMPACT_GRID=1
